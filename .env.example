# ==============================================================================
# Waffle Audio Environment Configuration Example
# Copy this file to .env or run `python setup.py` to configure interactively.
# ==============================================================================

# User Identity & Location (Personalization)
USER_NAME=
USER_LOCATION=
USER_TIMEZONE=

# Assistant Identity & Trigger Word
ASSISTANT_NAME=Waffle
VOICECHAT_TRIGGER_MODE=false

# Audio Hardware (Device index or "default")
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default

# Text-to-Speech Voice (Built-in or cloned voice name)
VOICECHAT_TTS_VOICE=anna

# LLM Provider Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# External API Tokens
GITHUB_PERSONAL_ACCESS_TOKEN=
