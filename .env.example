# ==============================================================================
# Waffle Audio Configuration (.env)
# Copy this file to .env or run `python setup.py` to configure interactively.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. User Personalization (No defaults - assistant will adapt to you)
# ------------------------------------------------------------------------------
USER_NAME=""
USER_LOCATION=""
USER_TIMEZONE=""

# ------------------------------------------------------------------------------
# 2. Assistant Identity & Text-to-Speech Engine
# ------------------------------------------------------------------------------
ASSISTANT_NAME="Waffle"
# Assistant Personality: "natural", "professional", "playful", "annoyed", "sarcastic", "empathetic", "enthusiastic", "concise", "philosophical"
VOICECHAT_PERSONALITY="natural"
# TTS backend: "pocket" (ultra-fast Kyutai streaming) or "kokoro" (high-quality ONNX)
VOICECHAT_TTS_BACKEND="pocket"
# TTS Voice: "anna", "af_sarah", or custom cloned voice name from cloned_voices/
VOICECHAT_TTS_VOICE="anna"
# Speech speed multiplier (e.g. 1.0, 1.1, 1.25)
VOICECHAT_TTS_SPEED="1.5"
# Quantize TTS model weights (true/false)
VOICECHAT_TTS_QUANTIZE="false"

# ------------------------------------------------------------------------------
# 3. Audio Hardware & Interaction Modes
# ------------------------------------------------------------------------------
# Input & Output device index (from PortAudio/sounddevice) or "default"
AUDIO_INPUT_DEVICE="default"
AUDIO_OUTPUT_DEVICE="default"

# Trigger Mode: when true, assistant only responds when "Hey <ASSISTANT_NAME>" is spoken
VOICECHAT_TRIGGER_MODE="false"

# Barge-In: instantly interrupt assistant speech when user starts talking (true/false)
VOICECHAT_BARGE_IN_ENABLED="false" # Bit glitchy at the moment

# Acoustic Echo Cancellation: cancels speaker output from mic feed (true/false)
VOICECHAT_AEC_ENABLED="false" # Bit glitchy at the moment

# ------------------------------------------------------------------------------
# 4. Silence Gate & Voice Activity Detection (VAD)
# ------------------------------------------------------------------------------
# Trailing silence duration before triggering response (seconds)
VOICECHAT_GAP_TIMEOUT="0.5"
# Quick-fire silence duration when sentence ends with terminal punctuation (?, !, .)
VOICECHAT_QUICK_FIRE_TIMEOUT="0.25"
# Silero VAD probability threshold (0.0 to 1.0)
VOICECHAT_VAD_THRESHOLD="0.5"
# Minimum silence required to end speech segment (milliseconds)
VOICECHAT_VAD_MIN_SILENCE_MS="200"
# Speech padding around detected speech (milliseconds)
VOICECHAT_VAD_SPEECH_PAD_MS="100"
# Audio pre-roll buffer to prevent cutting initial consonants (milliseconds)
VOICECHAT_VAD_PRE_SPEECH_PAD_MS="200"

# ------------------------------------------------------------------------------
# 5. Speech-to-Text (STT - Moonshine)
# ------------------------------------------------------------------------------
VOICECHAT_STT_LANGUAGE="en"
VOICECHAT_STT_UPDATE_INTERVAL="0.5"
VOICECHAT_STT_QUEUE_SIZE="200"

# ------------------------------------------------------------------------------
# 6. LLM & Ollama Runtime
# ------------------------------------------------------------------------------
# Reachable Ollama URL (auto-detected host IP in WSL2 or http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"
# Ollama model (e.g. qwen3.5:4b, gemma4:e4b, etc.)
OLLAMA_MODEL="qwen3.5:4b"
# Keep model in GPU VRAM to avoid cold loading penalties
OLLAMA_KEEP_ALIVE="30m"
# Maximum response tokens per spoken reply (keeps answers conversational)
OLLAMA_NUM_PREDICT="160"
# Context window size in tokens (2048 prevents CPU KV-cache spillover)
OLLAMA_NUM_CTX="2048"

# ------------------------------------------------------------------------------
# 7. Conversation Context Compactor & Memory
# ------------------------------------------------------------------------------
# Maximum turns preserved in active history window
VOICECHAT_MAX_HISTORY_TURNS="8"
# Seconds after assistant turn where user speech does not require wake word in trigger mode
VOICECHAT_FOLLOW_UP_WINDOW="15.0"
# Enable asynchronous background context compaction for long sessions
VOICECHAT_COMPACTOR_ENABLED="true"
# Compaction threshold in turn count
VOICECHAT_COMPACTOR_MAX_TURNS="6"
# Compaction character threshold
VOICECHAT_COMPACTOR_CHAR_LIMIT="2500"
# Recent turns to preserve verbatim
VOICECHAT_COMPACTOR_PRESERVE_TURNS="2"

# ------------------------------------------------------------------------------
# 8. Model Context Protocol (MCP) & Tools
# ------------------------------------------------------------------------------
VOICECHAT_TOOLS_ENABLED="true"
VOICECHAT_DDGS_ENABLED="true"
VOICECHAT_DDGS_MAX_RESULTS="4"
VOICECHAT_FILLER_PHRASES_ENABLED="true"
# Optional GitHub personal access token for GitHub MCP tool
GITHUB_PERSONAL_ACCESS_TOKEN=""
